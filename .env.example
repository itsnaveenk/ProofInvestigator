# Copy to .env.local and fill in. Server-side only.
ANAKIN_API_KEY=
# Hosted LLM: set ONE of these (Anthropic preferred) unless GENIEX_AGENT_MODEL is set. OpenRouter keys (sk-or-...) are detected automatically.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional hosted model override
LLM_MODEL=

# GenieX (Qualcomm on-device runtime, OpenAI-compatible server)
GENIEX_BASE_URL=http://127.0.0.1:18181/v1
# Screenshot reading (vision model) — required for the screenshot feature
GENIEX_VLM_MODEL=unsloth/Qwen3-VL-2B-Instruct-GGUF:Q4_0
# Set to run the agent and compare mode fully on-device instead of a hosted LLM
GENIEX_AGENT_MODEL=
